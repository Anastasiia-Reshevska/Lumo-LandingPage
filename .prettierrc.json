{
    "useTabs": false,
    "tabWidth": 2,
    "endOfLine": "lf",
    "printWidth": 100,
    "trailingComma": "es5",
    "singleQuote": true,
    "overrides": [
        {
            "files": [
                "*.scss",
                "*.css"
            ],
            "options": {
                "printWidth": 120,
                "singleQuote": false,
                "bracketSpacing": true
            }
        },
        {
            "files": [
                "*.blade.php"
            ],
            "options": {
                "parser": "html"
            }
        }
    ]
}
